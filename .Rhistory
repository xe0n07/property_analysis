avg_house_price, avg_download_speed, drug_offence_rate, avg_attainment8,
house_score, broadband_score, crime_score, education_score, overall_score
) %>%
mutate(across(where(is.numeric), ~ round(.x, 2)))
sample_sizes = recommendation %>%
select(Rank, town, n_sales, n_postcodes, n_schools)
cat("\n============================\n")
cat("FULL RANKED TABLE (", nrow(final_table), "towns )\n")
cat("============================\n")
print(final_table, n = Inf)
cat("\n============================\n")
cat("TOP", TOP_N, "RECOMMENDED TOWNS\n")
cat("============================\n\n")
top_towns = final_table %>% slice(1:min(TOP_N, nrow(final_table)))
print(top_towns, n = Inf)
small_sample = sample_sizes %>%
filter(Rank %in% top_towns$Rank, n_schools <= 2 | n_postcodes <= 20)
if (nrow(small_sample) > 0) {
cat("\nCaution - these top", TOP_N, "towns rest on a small sample for at least one pillar:\n")
print(small_sample)
}
dir.create("D:/Data_Science/Clean Data", showWarnings = FALSE, recursive = TRUE)
write_csv(final_table, out_path)
cat("\nSaved to :", out_path, "\n")
library(DBI)
library(RSQLite)
library(dplyr)
library(stringr)
library(readr)
db_path = "D:/Data_Science/Clean Data/norfolk_suffolk.db"
lookup_script = "D:/Data_Science/EDA 1/00_Postcode_Town_Lookup.R"
out_path = "D:/Data_Science/Clean Data/town_recommendation.csv"
source(lookup_script)
TOP_N = 10
extract_district_code = function(postcode) {
str_extract(str_to_upper(postcode), "^[A-Z]{1,2}[0-9]{1,2}")
}
con = dbConnect(SQLite(), db_path)
house_price_raw = dbGetQuery(con, "
SELECT hp.postcode, hp.price, hp.year, d.district_name, cn.county_name
FROM fact_house_price hp
JOIN dim_district d ON hp.district_id = d.district_id
JOIN dim_county cn ON d.county_id = cn.county_id
")
broadband_raw = dbGetQuery(con, "SELECT postcode, avg_speed FROM fact_broadband")
education_raw = dbGetQuery(con, "
SELECT e.att8_score, e.academic_year, s.postcode
FROM fact_education e
JOIN dim_school s ON e.estab = s.estab
WHERE e.att8_score IS NOT NULL
")
drug_crime_raw = dbGetQuery(con, "
SELECT c.lsoa_code, l.lsoa_name
FROM fact_crime c
JOIN dim_lsoa l ON c.lsoa_code = l.lsoa_code
WHERE c.in_boundary = 1
AND c.crime_type = 'Drugs'
")
population_by_lsoa = dbGetQuery(con, "SELECT lsoa_code, population FROM fact_population")
dbDisconnect(con)
latest_hp_year = house_price_raw %>%
count(year) %>%
filter(n >= 10000) %>%
pull(year) %>%
max()
latest_edu_year = max(education_raw$academic_year)
cat("\nHouse price year used  :", latest_hp_year, "(latest year with a full sample; partial years excluded)\n")
cat("Education year used    :", latest_edu_year, "\n")
house_price = house_price_raw %>%
mutate(district_code = extract_district_code(postcode)) %>%
left_join(postcode_town_lookup, by = c("district_code" = "district"))
house_town = house_price %>%
filter(!is.na(town), year == latest_hp_year) %>%
group_by(town) %>%
summarise(
county = names(sort(table(county_name), decreasing = TRUE))[1],
avg_house_price = mean(price, na.rm = TRUE),
n_sales = n(),
.groups = "drop"
)
cat("Towns with", latest_hp_year, "house price data :", nrow(house_town), "\n")
broadband_town = broadband_raw %>%
mutate(district_code = extract_district_code(postcode)) %>%
left_join(postcode_town_lookup, by = c("district_code" = "district")) %>%
filter(!is.na(town)) %>%
group_by(town) %>%
summarise(
avg_download_speed = mean(avg_speed, na.rm = TRUE),
n_postcodes = n(),
.groups = "drop"
)
cat("Towns with broadband data :", nrow(broadband_town), "\n")
education_town = education_raw %>%
filter(academic_year == latest_edu_year) %>%
mutate(district_code = extract_district_code(postcode)) %>%
left_join(postcode_town_lookup, by = c("district_code" = "district")) %>%
filter(!is.na(town)) %>%
group_by(town) %>%
summarise(
avg_attainment8 = mean(att8_score, na.rm = TRUE),
n_schools = n(),
.groups = "drop"
)
cat("Towns with", latest_edu_year, "Attainment 8 data :", nrow(education_town), "\n")
# crime has no postcode, so it can only reach administrative district
# (via LSOA), not town. Each town inherits the drug offence rate of
# whichever real LAD district its house-price postcodes most often
# fall under.
drug_by_district = drug_crime_raw %>%
mutate(district_name = str_trim(str_remove(lsoa_name, "\\s+[A-Za-z0-9]+$"))) %>%
count(district_name, lsoa_code, name = "drug_count") %>%
left_join(population_by_lsoa, by = "lsoa_code") %>%
filter(!is.na(population), population > 0) %>%
group_by(district_name) %>%
summarise(
total_drug_offences = sum(drug_count),
total_population = sum(population),
.groups = "drop"
) %>%
mutate(drug_offence_rate = (total_drug_offences / total_population) * 100000)
town_to_district = house_price %>%
filter(!is.na(town)) %>%
count(town, district_name, name = "n") %>%
group_by(town) %>%
slice_max(n, n = 1, with_ties = FALSE) %>%
ungroup() %>%
select(town, district_name)
crime_town = town_to_district %>%
left_join(drug_by_district, by = "district_name") %>%
filter(!is.na(drug_offence_rate)) %>%
select(town, drug_offence_rate)
cat("Towns with a matched district drug offence rate :", nrow(crime_town), "\n")
recommendation = house_town %>%
inner_join(broadband_town, by = "town") %>%
inner_join(education_town, by = "town") %>%
inner_join(crime_town, by = "town")
cat("\nTowns with complete data across all 4 pillars :", nrow(recommendation), "\n")
if (nrow(recommendation) == 0) {
stop("No towns matched across all 4 pillars. Check town-name spelling consistency between datasets.")
}
recommendation = recommendation %>%
mutate(
house_score = 10 * (max(avg_house_price) - avg_house_price) /
(max(avg_house_price) - min(avg_house_price)),
broadband_score = 10 * (avg_download_speed - min(avg_download_speed)) /
(max(avg_download_speed) - min(avg_download_speed)),
crime_score = 10 * (max(drug_offence_rate) - drug_offence_rate) /
(max(drug_offence_rate) - min(drug_offence_rate)),
education_score = 10 * (avg_attainment8 - min(avg_attainment8)) /
(max(avg_attainment8) - min(avg_attainment8)),
overall_score = (
house_score +
broadband_score +
crime_score +
education_score
) / 4
) %>%
arrange(desc(overall_score)) %>%
mutate(Rank = row_number())
recommendation = recommendation %>%
mutate(county = toupper(county))
final_table = recommendation %>%
select(
Rank, town, county,
avg_house_price, avg_download_speed, drug_offence_rate, avg_attainment8,
house_score, broadband_score, crime_score, education_score, overall_score
) %>%
mutate(across(where(is.numeric), ~ round(.x, 2)))
sample_sizes = recommendation %>%
select(Rank, town, n_sales, n_postcodes, n_schools)
cat("\n============================\n")
cat("FULL RANKED TABLE (", nrow(final_table), "towns )\n")
cat("============================\n")
print(final_table, n = Inf)
cat("\n============================\n")
cat("TOP", TOP_N, "RECOMMENDED TOWNS\n")
cat("============================\n\n")
top_towns = final_table %>% slice(1:min(TOP_N, nrow(final_table)))
print(top_towns, n = Inf)
small_sample = sample_sizes %>%
filter(Rank %in% top_towns$Rank, n_schools <= 2 | n_postcodes <= 20)
if (nrow(small_sample) > 0) {
cat("\nCaution - these top", TOP_N, "towns rest on a small sample for at least one pillar:\n")
print(small_sample)
}
dir.create("D:/Data_Science/Clean Data", showWarnings = FALSE, recursive = TRUE)
write_csv(final_table, out_path)
cat("\nSaved to :", out_path, "\n")
